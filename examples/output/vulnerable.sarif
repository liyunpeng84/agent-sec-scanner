{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "agent-sec-scanner",
          "version": "0.1.0",
          "rules": [
            {
              "id": "ASC001",
              "name": "tool-poisoning",
              "shortDescription": {
                "text": "Prompt injection / tool poisoning in tool or agent text"
              },
              "fullDescription": {
                "text": "Tool descriptions and other prose fields are fed to the model verbatim. Imperative text aimed at the model (override instructions, hide actions from the user, fake <IMPORTANT>/<system> tags) is the classic MCP tool-poisoning vector. Patterns cover English and Chinese."
              },
              "help": {
                "text": "Do not install/enable this server until the description is reviewed. Descriptions should only describe what the tool does for a human; remove imperative instructions to the model, hidden tags and comments. Pin the server version so a later update cannot silently change the text (rug pull)."
              },
              "helpUri": "https://invariantlabs.ai/blog/mcp-security-notification-tool-poisoning-attacks",
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC002",
              "name": "hidden-unicode",
              "shortDescription": {
                "text": "Invisible / bidirectional Unicode characters"
              },
              "fullDescription": {
                "text": "Zero-width, bidi-override and Unicode 'tag' characters render invisibly to humans but are read by the model. They are used to smuggle instructions past reviewers."
              },
              "help": {
                "text": "Strip non-printing characters (e.g. normalise with a whitelist) and re-review the visible text. Treat the source as untrusted."
              },
              "helpUri": "https://embracethered.com/blog/posts/2024/hiding-and-finding-text-with-unicode-tags/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC003",
              "name": "sensitive-data-instruction",
              "shortDescription": {
                "text": "Tool text references credentials or outbound exfiltration"
              },
              "fullDescription": {
                "text": "A tool description that mentions SSH keys, cloud credentials, other agents' config files, or tells the model to send content to a URL / e-mail address is a strong indicator of a data-exfiltration attempt."
              },
              "help": {
                "text": "Remove the server unless the reference is clearly legitimate (e.g. an SSH-management tool). Never let a tool's text decide which local files the agent reads; restrict the server's filesystem access and outbound network instead."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC004",
              "name": "tool-shadowing",
              "shortDescription": {
                "text": "Tool shadowing / cross-tool manipulation"
              },
              "fullDescription": {
                "text": "A tool whose description talks about how *other* tools must behave, or two servers exposing the same tool name, lets one server hijack calls meant for another (cross-origin escalation)."
              },
              "help": {
                "text": "Remove the offending server or rename/namespace the colliding tools. Tools should only describe themselves."
              },
              "helpUri": "https://invariantlabs.ai/blog/mcp-security-notification-tool-poisoning-attacks",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC010",
              "name": "hardcoded-secret",
              "shortDescription": {
                "text": "Hard-coded secret / credential in config"
              },
              "fullDescription": {
                "text": "Agent and MCP config files are frequently committed, synced, shared in screenshots, or readable by every installed MCP server and by the agent itself (and therefore by any prompt injection)."
              },
              "help": {
                "text": "Rotate the credential now, then reference it from the environment or a secret manager instead of a literal, e.g. VS Code: \"${input:token}\" / \"${env:TOKEN}\"; Claude/Cursor: set it in your shell profile or OS keychain and keep only the variable name in the file. Add the file to .gitignore."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC020",
              "name": "dangerous-command",
              "shortDescription": {
                "text": "Unsafe command used to launch an MCP server"
              },
              "fullDescription": {
                "text": "stdio MCP servers run as local processes with your user's privileges. Shell one-liners that download and execute code, elevated privileges, or privileged containers turn any compromise of the package or URL into full machine compromise."
              },
              "help": {
                "text": "Install the server from a pinned, reviewed package and call its binary directly (no `sh -c`, no `curl | sh`, no sudo). If you containerise it, drop --privileged/docker.sock and mount only the project directory read-only."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC021",
              "name": "unpinned-package",
              "shortDescription": {
                "text": "MCP server package/image is not version-pinned"
              },
              "fullDescription": {
                "text": "`npx -y pkg`, `uvx pkg`, `pkg@latest` or `image:latest` fetch whatever was published most recently at every launch. A compromised or malicious update (a 'rug pull') runs automatically with no review."
              },
              "help": {
                "text": "Pin an exact version (npx -y pkg@1.2.3, uvx pkg==1.2.3, docker image@sha256:...) and review changes before bumping."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC022",
              "name": "tls-disabled",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "fullDescription": {
                "text": "Disabling certificate checks lets anyone on the network path impersonate the MCP endpoint or package registry and inject tool descriptions or responses."
              },
              "help": {
                "text": "Remove the flag/variable; if you use a corporate proxy, add its CA to the trust store (NODE_EXTRA_CA_CERTS / SSL_CERT_FILE) instead."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC030",
              "name": "overbroad-filesystem",
              "shortDescription": {
                "text": "File-system access scope is too broad"
              },
              "fullDescription": {
                "text": "Granting a filesystem/terminal server your whole disk or home directory gives every prompt injection access to SSH keys, browser profiles, cloud credentials and other agents' configs."
              },
              "help": {
                "text": "Scope the server to the specific project directories it needs (preferably read-only), e.g. `npx -y @modelcontextprotocol/server-filesystem@<ver> /path/to/project`."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC031",
              "name": "auto-approve",
              "shortDescription": {
                "text": "Human approval or sandbox disabled for agent tool calls"
              },
              "fullDescription": {
                "text": "Auto-approving tool calls (YOLO / bypassPermissions / alwaysAllow / approval_policy=never) removes the last human check between a prompt injection and a real side effect (shell commands, file writes, outbound requests)."
              },
              "help": {
                "text": "Keep confirmation on for exec/write/network tools. Allow-list only narrow, read-only commands (e.g. `Bash(git status)` rather than `Bash(*)`), keep the sandbox on (Codex: sandbox_mode = \"workspace-write\"), and never trust a whole MCP server."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC040",
              "name": "suspicious-endpoint",
              "shortDescription": {
                "text": "Insecure or suspicious remote MCP endpoint"
              },
              "fullDescription": {
                "text": "Remote MCP servers receive your prompts/tool arguments and control the tool descriptions your agent reads. Plain HTTP, raw IPs, tunnel/request-catcher domains and punycode hosts are typical of throw-away or attacker-controlled endpoints."
              },
              "help": {
                "text": "Use HTTPS endpoints operated by the vendor you intend to trust, authenticate with OAuth / scoped tokens, and avoid tunnel or request-bin domains in shared configs."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC041",
              "name": "exposed-bind",
              "shortDescription": {
                "text": "Local MCP server exposed on all network interfaces"
              },
              "fullDescription": {
                "text": "A local server bound to 0.0.0.0 / :: is reachable from the LAN (or the internet on a cloud VM). Many MCP servers have no auth."
              },
              "help": {
                "text": "Bind to 127.0.0.1 and, for remote use, put the server behind authentication (OAuth / token) and TLS."
              },
              "helpUri": "https://github.com/",
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            },
            {
              "id": "ASC050",
              "name": "toxic-combination",
              "shortDescription": {
                "text": "Untrusted-input + powerful-action servers in the same agent"
              },
              "fullDescription": {
                "text": "When one agent can both read attacker-controllable content (web, e-mail, issues, chat) and run commands / touch files / databases, a single injected document can drive the powerful tool. Risk is higher when calls are auto-approved."
              },
              "help": {
                "text": "Split these capabilities into separate agent profiles/workspaces, keep confirmation on for the powerful tools, and scope credentials to read-only where possible."
              },
              "helpUri": "https://simonwillison.net/2025/Jun/16/the-lethal-trifecta/",
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "mcp",
                  "ai-agent"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ASC031",
          "level": "error",
          "message": {
            "text": "Claude Code permission prompts are bypassed (bypassPermissions). Fix: Keep confirmation on for exec/write/network tools. Allow-list only narrow, read-only commands (e.g. `Bash(git status)` rather than `Bash(*)`), keep the sandbox on (Codex: sandbox_mode = \"workspace-write\"), and never trust a whole MCP server."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/vulnerable/claude-settings.json"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "location": "permissions.defaultMode",
            "evidence": "defaultMode: bypassPermissions",
            "security-severity": "9.5"
          }
        },
        {
          "ruleId": "ASC030",
          "level": "error",
          "message": {
            "text": "server 'filesystem' is given access to '/'. Fix: Scope the server to the specific project directories it needs (preferably read-only), e.g. `npx -y @modelcontextprotocol/server-filesystem@<ver> /path/to/project`."
          },
          "locations": [
            {
